"use client";
import { useEffect, useState, useCallback } from "react";
import { useParams, useRouter } from "next/navigation";
import { api } from "@/lib/api";
import { useJobStatus } from "@/hooks/useJobStatus";
import { StatusChip } from "@/components/ui/StatusChip";
import { PipelineBadge } from "@/components/ui/PipelineBadge";
import { ProgressQueueWidget } from "@/components/ui/ProgressQueueWidget";
import { DisclaimerBanner } from "@/components/ui/DisclaimerBanner";
import type { Song, GenerationJob, JobStage } from "@/types";

export default function SongStudioPage() {
  const params = useParams();
  const router = useRouter();
  const songId = params.id as string;

  const [song, setSong] = useState<Song | null>(null);
  const [jobs, setJobs] = useState<GenerationJob[]>([]);
  const [generating, setGenerating] = useState(false);
  const [approving, setApproving] = useState(false);

  const compositionJob = jobs.find(j => j.jobType === "AUDIO_COMPOSITION");
  const mixJob = jobs.find(j => j.jobType === "AUDIO_MIX");

  const { stage: compStage } = useJobStatus(compositionJob?.id, compositionJob?.stage || "QUEUED");
  const { stage: mixStage } = useJobStatus(mixJob?.id, mixJob?.stage || "QUEUED");

  const loadSong = useCallback(async () => {
    try {
      const s = await api.songs.get(songId);
      setSong(s);
    } catch (err) {
      console.error("Failed to load song:", err);
    }
  }, [songId]);

  const loadJobs = useCallback(async () => {
    try {
      const j = await api.songs.getJobs(songId);
      setJobs(j);
    } catch (err) {
      console.error("Failed to load jobs:", err);
    }
  }, [songId]);

  useEffect(() => {
    loadSong();
    loadJobs();
  }, [loadSong, loadJobs]);

  // Refresh song status when jobs complete
  useEffect(() => {
    if (compStage === "COMPLETE" || mixStage === "COMPLETE") {
      loadSong();
    }
  }, [compStage, mixStage, loadSong]);

  const handleGenerate = async () => {
    setGenerating(true);
    try {
      const result = await api.songs.generate(songId, "HYBRID");
      await loadJobs();
      await loadSong();
    } catch (err) {
      console.error("Generation failed:", err);
    }
    setGenerating(false);
  };

  const handleApprove = async () => {
    setApproving(true);
    try {
      const updated = await api.songs.approve(songId);
      setSong(updated);
    } catch (err) {
      console.error("Approve failed:", err);
    }
    setApproving(false);
  };

  const overallStatus = song?.status || "DRAFT";
  const hasJobs = jobs.length > 0;
  const isApproved = overallStatus === "APPROVED" || overallStatus === "PUBLISHED";

  const queueItems: { label: string; stage: JobStage; eta?: string }[] = hasJobs
    ? [
        { label: "AI composition pass", stage: compStage, eta: compStage === "PROCESSING" ? "~30 seconds" : undefined },
        { label: "Human producer polish", stage: mixStage, eta: mixStage === "NEEDS_HUMAN_INPUT" ? "4-6 hours" : undefined },
      ]
    : [
        { label: "AI composition pass", stage: "QUEUED" as JobStage },
        { label: "Human producer polish", stage: "QUEUED" as JobStage, eta: "4-6 hours" },
      ];

  return (
    <div className="min-h-screen p-8">
      <div className="flex items-center justify-between mb-6 max-w-5xl mx-auto">
        <div>
          <h1 className="text-xl font-bold">Song Studio</h1>
          <p className="text-sm text-neutral-400 mt-1">{song?.title || "Loading..."}</p>
        </div>
        <PipelineBadge mode={song?.pipelineMode || "HYBRID"} />
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {/* LEFT: Song Details */}
        <div className="bg-neutral-700 border border-neutral-500 rounded-[16px] p-6 space-y-4">
          <h2 className="text-sm font-semibold text-neutral-400">Song Details</h2>

          <div>
            <label className="text-xs text-neutral-400">Title</label>
            <p className="text-sm mt-0.5">{song?.title || "—"}</p>
          </div>

          {song?.lyricsInput && (
            <div>
              <label className="text-xs text-neutral-400">Lyrics / Prompt</label>
              <p className="text-sm mt-0.5 whitespace-pre-wrap bg-neutral-900 rounded-md p-3 max-h-40 overflow-y-auto">
                {song.lyricsInput}
              </p>
            </div>
          )}

          <div className="grid grid-cols-3 gap-3">
            <div>
              <label className="text-xs text-neutral-400">Mood</label>
              <p className="text-sm mt-0.5">{((song?.moodValue ?? 0.5) * 100).toFixed(0)}%</p>
            </div>
            <div>
              <label className="text-xs text-neutral-400">Tempo</label>
              <p className="text-sm mt-0.5">{song?.tempoBpm ?? "—"} BPM</p>
            </div>
            <div>
              <label className="text-xs text-neutral-400">Key</label>
              <p className="text-sm mt-0.5">{song?.musicalKey ?? "—"}</p>
            </div>
          </div>

          {!hasJobs && !isApproved && (
            <button
              onClick={handleGenerate}
              disabled={generating}
              className="w-full bg-primary text-white rounded-md py-3 font-medium disabled:opacity-40"
            >
              {generating ? "Starting Generation..." : "Generate Draft"}
            </button>
          )}

          <DisclaimerBanner type="ai_content" />
        </div>

        {/* RIGHT: Pipeline Progress */}
        <div className="bg-neutral-700 border border-neutral-500 rounded-[16px] p-6 space-y-4">
          <h2 className="text-sm font-semibold text-neutral-400">Pipeline Progress</h2>

          {/* Audio Preview Area */}
          <div className="bg-neutral-900 rounded-[12px] p-4 min-h-[80px] flex items-center justify-center">
            {!hasJobs && (
              <p className="text-sm text-neutral-400">Click "Generate Draft" to begin</p>
            )}
            {hasJobs && compStage !== "COMPLETE" && (
              <div className="flex items-center gap-3">
                <div className="w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin" />
                <p className="text-sm text-neutral-400">AI is composing your track...</p>
              </div>
            )}
            {hasJobs && compStage === "COMPLETE" && (
              <div className="w-full">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center">
                    <span className="text-primary text-lg">♪</span>
                  </div>
                  <span className="text-sm">AI Draft Ready</span>
                </div>
                {/* Simulated waveform */}
                <div className="flex items-end gap-0.5 h-10">
                  {Array.from({ length: 60 }).map((_, i) => (
                    <div
                      key={i}
                      className="flex-1 bg-primary/60 rounded-sm"
                      style={{ height: `${Math.random() * 100}%` }}
                    />
                  ))}
                </div>
              </div>
            )}
          </div>

          <StatusChip status={hasJobs ? compStage : overallStatus} />

          <ProgressQueueWidget items={queueItems} />

          {/* Action Buttons */}
          <div className="flex gap-3 pt-2">
            {hasJobs && !isApproved && (
              <>
                <button
                  onClick={handleGenerate}
                  disabled={generating || compStage === "PROCESSING"}
                  className="flex-1 border border-neutral-500 rounded-md py-2 text-sm disabled:opacity-40"
                >
                  Regenerate
                </button>
                <button
                  onClick={handleApprove}
                  disabled={approving || compStage !== "COMPLETE"}
                  className="flex-1 bg-secondary text-neutral-900 rounded-md py-2 text-sm font-medium disabled:opacity-40"
                >
                  {approving ? "Approving..." : "Approve Draft"}
                </button>
              </>
            )}

            {isApproved && (
              <button
                onClick={() => router.push(`/studio/video/${songId}`)}
                className="flex-1 bg-primary text-white rounded-md py-2 text-sm font-medium"
              >
                Create Music Video →
              </button>
            )}
          </div>

          {isApproved && (
            <div className="bg-secondary/10 border border-secondary/30 rounded-md p-3 text-sm text-secondary">
              ✓ Song approved! You can now create a music video or proceed to the bundle builder.
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
