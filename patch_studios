import { useEffect, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import { api } from "@/lib/api";
import { TierSelector } from "@/components/ui/TierSelector";
import { ValuationCard } from "@/components/ui/ValuationCard";
import { DisclaimerBanner } from "@/components/ui/DisclaimerBanner";
import { PipelineBadge } from "@/components/ui/PipelineBadge";
import type { Valuation } from "@/types";

const PRODUCT_TIERS = [
  { id: "STARTER", name: "Starter", description: "Song + NFT", price: "$97" },
  { id: "GROWTH", name: "Growth", description: "+Video +Marketing", price: "$297", recommended: true },
  { id: "ENTERPRISE", name: "Enterprise", description: "+Full Suite", price: "$997" },
];

export default function BundleBuilderPage() {
  const params = useParams();
  const router = useRouter();
  const songId = params.songId as string;

  const [song, setSong] = useState<any>(null);
  const [valuation, setValuation] = useState<Valuation | null>(null);
  const [selectedTier, setSelectedTier] = useState<string>("GROWTH");
  const [supply, setSupply] = useState({ collector: 1000, superfan: 100, investor: 10 });
  const [royaltyPct, setRoyaltyPct] = useState(10);
  const [chain, setChain] = useState("POLYGON");
  const [perks, setPerks] = useState<string[]>(["exclusive_cut", "discord_role"]);
  const [configuring, setConfiguring] = useState(false);

  const clientId = typeof window !== "undefined" ? localStorage.getItem("polsia_client_id") : null;

  useEffect(() => {
    api.songs.get(songId).then(setSong).catch(() => {});
    api.valuation.get(songId).then(v => { if (v) setValuation(v); }).catch(() => {});
  }, [songId]);

  const togglePerk = (perk: string) => {
    setPerks(prev => prev.includes(perk) ? prev.filter(p => p !== perk) : [...prev, perk]);
  };

  const handleConfigure = async () => {
    if (!clientId) return;
    setConfiguring(true);
    try {
      // Configure NFT
      await api.nft.configure({
        songId,
        chain,
        royaltyBps: royaltyPct * 100,
        tiers: [
          { tierName: "COLLECTOR", supplyTotal: supply.collector, priceUsd: 25, unlockPerks: perks },
          { tierName: "SUPERFAN", supplyTotal: supply.superfan, priceUsd: 250, unlockPerks: perks },
          { tierName: "INVESTOR", supplyTotal: supply.investor, priceUsd: 2500, unlockPerks: [...perks, "equity_option"], royaltyShareBps: 500 },
        ],
      });

      // Calculate initial valuation
      await api.valuation.recalculate(songId);
      const v = await api.valuation.get(songId);
      if (v) setValuation(v);

      // Create business plan
      const plan = await api.businessPlan.create({
        clientId,
        songId,
        selectedTier,
      });

      router.push(`/master-plan/${plan.id}/profile`);
    } catch (err) {
      console.error("Configuration failed:", err);
    }
    setConfiguring(false);
  };

  return (
    <div className="min-h-screen p-8 max-w-5xl mx-auto space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold">Bundle Builder</h1>
          <p className="text-sm text-neutral-400 mt-1">{song?.title || "Loading..."}</p>
        </div>
        <PipelineBadge mode={song?.pipelineMode || "HYBRID"} />
      </div>

      {/* Song/Video Preview */}
      <div className="bg-neutral-700 border border-neutral-500 rounded-[16px] p-4">
        <div className="bg-neutral-900 rounded-[12px] aspect-video max-h-48 flex items-center justify-center">
          <div className="text-center">
            <p className="text-2xl mb-1">🎵</p>
            <p className="text-sm text-neutral-400">Teaser preview will auto-cut from your approved assets</p>
          </div>
        </div>
      </div>

      {/* Product Tier Selection */}
      <div>
        <h2 className="text-sm font-semibold mb-3">Select Product Tier</h2>
        <TierSelector tiers={PRODUCT_TIERS} selectedId={selectedTier} onSelect={setSelectedTier} />
      </div>

      {/* NFT Configurator */}
      <div className="bg-neutral-700 border border-neutral-500 rounded-[16px] p-6 space-y-4">
        <h2 className="text-sm font-semibold">NFT Configurator</h2>

        <div className="grid grid-cols-3 gap-4">
          {(["collector", "superfan", "investor"] as const).map(tier => (
            <div key={tier}>
              <label className="text-xs text-neutral-400 capitalize">{tier} Supply</label>
              <input
                type="number"
                value={supply[tier]}
                onChange={e => setSupply({ ...supply, [tier]: parseInt(e.target.value) || 0 })}
                className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-2 text-sm"
              />
            </div>
          ))}
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div>
            <label className="text-xs text-neutral-400">Royalty %</label>
            <input
              type="number"
              value={royaltyPct}
              onChange={e => setRoyaltyPct(parseInt(e.target.value) || 0)}
              className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-2 text-sm"
            />
          </div>
          <div>
            <label className="text-xs text-neutral-400">Chain</label>
            <select
              value={chain}
              onChange={e => setChain(e.target.value)}
              className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-2 text-sm"
            >
              <option value="POLYGON">Polygon</option>
              <option value="BASE">Base</option>
              <option value="ETHEREUM">Ethereum</option>
            </select>
          </div>
        </div>

        <div>
          <label className="text-xs text-neutral-400 block mb-2">Unlock Perks</label>
          <div className="flex flex-wrap gap-4 text-sm">
            {[
              { key: "exclusive_cut", label: "Exclusive Cut" },
              { key: "discord_role", label: "Discord Role" },
              { key: "equity_option", label: "Equity Option" },
              { key: "meet_greet", label: "Meet & Greet" },
            ].map(perk => (
              <label key={perk.key} className="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  checked={perks.includes(perk.key)}
                  onChange={() => togglePerk(perk.key)}
                  className="accent-primary"
                />
                {perk.label}
              </label>
            ))}
          </div>
        </div>

        {perks.includes("equity_option") && <DisclaimerBanner type="securities" />}
      </div>

      {/* Valuation */}
      {valuation && <ValuationCard valuation={valuation} />}

      {/* Actions */}
      <div className="flex justify-end gap-3">
        <button className="border border-neutral-500 rounded-md px-5 py-2.5 text-sm">Save Draft</button>
        <button
          onClick={handleConfigure}
          disabled={configuring || !clientId}
          className="bg-primary text-white rounded-md px-5 py-2.5 text-sm font-medium disabled:opacity-40"
        >
          {configuring ? "Configuring..." : "Configure & Create Master Plan →"}
        </button>
      </div>
    </div>
  );
}
EOF

