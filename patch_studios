"use client";
import { useEffect, useState, useCallback } from "react";
import { useParams, useRouter } from "next/navigation";
import { api } from "@/lib/api";
import { useJobStatus } from "@/hooks/useJobStatus";
import { StatusChip } from "@/components/ui/StatusChip";
import { PipelineBadge } from "@/components/ui/PipelineBadge";
import { ProgressQueueWidget } from "@/components/ui/ProgressQueueWidget";
import { DisclaimerBanner } from "@/components/ui/DisclaimerBanner";
import type { GenerationJob, JobStage } from "@/types";

export default function VideoStudioPage() {
  const params = useParams();
  const router = useRouter();
  const songId = params.id as string;

  const [song, setSong] = useState<any>(null);
  const [videoId, setVideoId] = useState<string | null>(null);
  const [jobs, setJobs] = useState<GenerationJob[]>([]);
  const [scenes, setScenes] = useState(["", ""]);
  const [cameraStyle, setCameraStyle] = useState("Dynamic");
  const [colorPalette, setColorPalette] = useState(["#6C4DFF", "#00E5A0", "#FF4D6D"]);
  const [generating, setGenerating] = useState(false);
  const [approved, setApproved] = useState(false);

  const renderJob = jobs.find(j => j.jobType === "VIDEO_RENDER");
  const editJob = jobs.find(j => j.jobType === "VIDEO_EDIT");

  const { stage: renderStage } = useJobStatus(renderJob?.id, renderJob?.stage || "QUEUED");
  const { stage: editStage } = useJobStatus(editJob?.id, editJob?.stage || "QUEUED");

  const loadSong = useCallback(async () => {
    try {
      const s = await api.songs.get(songId);
      setSong(s);
      if (s.video) {
        setVideoId(s.video.id);
        setScenes(s.video.scenePrompts?.length ? s.video.scenePrompts : ["", ""]);
        setCameraStyle(s.video.cameraStyle || "Dynamic");
      }
    } catch (err) {
      console.error(err);
    }
  }, [songId]);

  useEffect(() => { loadSong(); }, [loadSong]);

  const addScene = () => setScenes([...scenes, ""]);
  const removeScene = (i: number) => setScenes(scenes.filter((_, idx) => idx !== i));
  const updateScene = (i: number, val: string) => {
    const next = [...scenes];
    next[i] = val;
    setScenes(next);
  };

  const handleGenerate = async () => {
    setGenerating(true);
    try {
      const filteredScenes = scenes.filter(s => s.trim());
      if (filteredScenes.length === 0) {
        alert("Add at least one scene prompt");
        setGenerating(false);
        return;
      }

      let vid = videoId;
      if (!vid) {
        const video = await api.videos.create({
          songId,
          scenePrompts: filteredScenes,
          cameraStyle,
          colorPalette,
          styleRefUrls: [],
        });
        vid = video.id;
        setVideoId(vid);
      }

      const result = await api.videos.generate(vid);

      // Reload to get job IDs
      const s = await api.songs.get(songId);
      if (s.video) {
        // Fetch video-specific jobs
        const allJobs = await api.songs.getJobs(songId);
        // Video jobs have videoId set
        setJobs(allJobs.filter((j: any) => j.videoId));
      }
    } catch (err) {
      console.error("Video generation failed:", err);
    }
    setGenerating(false);
  };

  const handleApprove = () => {
    setApproved(true);
  };

  const renderProgress = renderStage === "COMPLETE" ? 100 : renderStage === "PROCESSING" ? 65 : 0;

  const queueItems: { label: string; stage: JobStage; eta?: string }[] = jobs.length > 0
    ? [
        { label: "Scene draft render", stage: renderStage },
        { label: "Beat-sync pass", stage: renderStage === "COMPLETE" ? "COMPLETE" as JobStage : "QUEUED" as JobStage },
        { label: "Editor finishing touch", stage: editStage, eta: editStage === "NEEDS_HUMAN_INPUT" ? "6 hours" : undefined },
      ]
    : [
        { label: "Scene draft render", stage: "QUEUED" as JobStage },
        { label: "Beat-sync pass", stage: "QUEUED" as JobStage },
        { label: "Editor finishing touch", stage: "QUEUED" as JobStage, eta: "6 hours" },
      ];

  return (
    <div className="min-h-screen p-8">
      <div className="flex items-center justify-between mb-6 max-w-5xl mx-auto">
        <div>
          <h1 className="text-xl font-bold">Video Studio</h1>
          <p className="text-sm text-neutral-400 mt-1">{song?.title || "Loading..."}</p>
        </div>
        <PipelineBadge mode="HYBRID" />
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {/* LEFT: Style Board */}
        <div className="bg-neutral-700 border border-neutral-500 rounded-[16px] p-6 space-y-4">
          <h2 className="text-sm font-semibold text-neutral-400">Style Board</h2>

          <div>
            <label className="text-sm text-neutral-400">Camera Style</label>
            <select
              value={cameraStyle}
              onChange={e => setCameraStyle(e.target.value)}
              className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-2 text-sm"
            >
              <option>Dynamic</option>
              <option>Static / Cinematic</option>
              <option>Handheld</option>
              <option>Drone / Aerial</option>
              <option>Close-up / Intimate</option>
            </select>
          </div>

          <div>
            <label className="text-sm text-neutral-400">Color Palette</label>
            <div className="flex gap-2 mt-1">
              {colorPalette.map((color, i) => (
                <input
                  key={i}
                  type="color"
                  value={color}
                  onChange={e => {
                    const next = [...colorPalette];
                    next[i] = e.target.value;
                    setColorPalette(next);
                  }}
                  className="w-10 h-10 rounded-md border border-neutral-500 cursor-pointer bg-transparent"
                />
              ))}
            </div>
          </div>

          <div>
            <label className="text-sm text-neutral-400">Scene Prompts</label>
            {scenes.map((scene, i) => (
              <div key={i} className="flex gap-2 mt-2">
                <input
                  value={scene}
                  onChange={e => updateScene(i, e.target.value)}
                  placeholder={`Scene ${i + 1}: Describe the visual...`}
                  className="flex-1 bg-neutral-900 border border-neutral-500 rounded-md p-2 text-sm"
                />
                {scenes.length > 1 && (
                  <button
                    onClick={() => removeScene(i)}
                    className="text-accent text-xs px-2 hover:bg-accent/10 rounded"
                  >
                    ✕
                  </button>
                )}
              </div>
            ))}
            <button onClick={addScene} className="text-xs text-primary mt-2 hover:underline">
              + Add scene
            </button>
          </div>

          <button
            onClick={handleGenerate}
            disabled={generating}
            className="w-full bg-primary text-white rounded-md py-3 font-medium disabled:opacity-40"
          >
            {generating ? "Starting Generation..." : jobs.length > 0 ? "Regenerate Video" : "Generate Video"}
          </button>

          <DisclaimerBanner type="ai_content" />
        </div>

        {/* RIGHT: Preview + Pipeline */}
        <div className="bg-neutral-700 border border-neutral-500 rounded-[16px] p-6 space-y-4">
          <h2 className="text-sm font-semibold text-neutral-400">Preview & Pipeline</h2>

          {/* Video Preview Area */}
          <div className="bg-neutral-900 rounded-[12px] aspect-video flex items-center justify-center relative overflow-hidden">
            {jobs.length === 0 && (
              <p className="text-sm text-neutral-400">Configure style and generate</p>
            )}
            {jobs.length > 0 && renderStage !== "COMPLETE" && (
              <div className="text-center">
                <div className="w-12 h-12 border-2 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-3" />
                <p className="text-sm text-neutral-400">Rendering scenes...</p>
                <div className="w-48 h-1.5 bg-neutral-500 rounded-full mt-2 mx-auto">
                  <div
                    className="h-1.5 bg-primary rounded-full transition-all duration-1000"
                    style={{ width: `${renderProgress}%` }}
                  />
                </div>
              </div>
            )}
            {jobs.length > 0 && renderStage === "COMPLETE" && (
              <div className="relative w-full h-full">
                {/* Simulated video frames */}
                <div className="absolute inset-0 grid grid-cols-3 grid-rows-2 gap-1 p-2">
                  {scenes.filter(s => s).slice(0, 6).map((_, i) => (
                    <div
                      key={i}
                      className="rounded bg-gradient-to-br from-primary/30 to-secondary/20 flex items-center justify-center"
                    >
                      <span className="text-xs text-neutral-400">Scene {i + 1}</span>
                    </div>
                  ))}
                </div>
                <div className="absolute bottom-2 left-2 right-2 flex items-center gap-2">
                  <button className="w-8 h-8 rounded-full bg-white/90 flex items-center justify-center">
                    <span className="text-neutral-900 text-sm ml-0.5">▶</span>
                  </button>
                  <div className="flex-1 h-1 bg-neutral-500 rounded-full">
                    <div className="h-1 bg-primary rounded-full w-0" />
                  </div>
                  <span className="text-xs text-neutral-400">0:00</span>
                </div>
              </div>
            )}

            {/* Pipeline Badge overlay */}
            <div className="absolute top-2 right-2">
              <PipelineBadge mode="HYBRID" />
            </div>
          </div>

          {/* Timeline */}
          {jobs.length > 0 && renderStage === "COMPLETE" && (
            <div>
              <label className="text-xs text-neutral-400">Timeline — Beat-sync markers</label>
              <div className="flex items-center gap-1 mt-1 h-6 bg-neutral-900 rounded-md px-2">
                {Array.from({ length: 20 }).map((_, i) => (
                  <div key={i} className={`flex-1 h-3 rounded-sm ${i % 4 === 0 ? "bg-primary" : "bg-neutral-500"}`} />
                ))}
              </div>
            </div>
          )}

          <StatusChip status={jobs.length > 0 ? renderStage : "DRAFT"} />

          <ProgressQueueWidget items={queueItems} />

          {/* Action Buttons */}
          <div className="flex gap-3 pt-2">
            {jobs.length > 0 && !approved && (
              <button
                onClick={handleApprove}
                disabled={renderStage !== "COMPLETE"}
                className="flex-1 bg-secondary text-neutral-900 rounded-md py-2 text-sm font-medium disabled:opacity-40"
              >
                Approve for Bundle
              </button>
            )}

            {approved && (
              <button
                onClick={() => router.push(`/bundle-builder/${songId}`)}
                className="flex-1 bg-primary text-white rounded-md py-2 text-sm font-medium"
              >
                Continue to Bundle Builder →
              </button>
            )}
          </div>

          {approved && (
            <div className="bg-secondary/10 border border-secondary/30 rounded-md p-3 text-sm text-secondary">
              ✓ Video approved! Continue to the bundle builder to configure your NFT and product tiers.
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
