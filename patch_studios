"use client";
import { useState } from "react";
import { useRouter } from "next/navigation";
import { api } from "@/lib/api";

export default function NewSongPage() {
  const router = useRouter();
  const [title, setTitle] = useState("");
  const [lyrics, setLyrics] = useState("");
  const [mood, setMood] = useState(0.5);
  const [tempo, setTempo] = useState(120);
  const [musicalKey, setMusicalKey] = useState("C Minor");
  const [creating, setCreating] = useState(false);

  const clientId = typeof window !== "undefined" ? localStorage.getItem("polsia_client_id") : null;

  const handleCreate = async () => {
    if (!clientId || !title) return;
    setCreating(true);
    try {
      const song = await api.songs.create({
        clientId,
        title,
        lyricsInput: lyrics,
        moodValue: mood,
        tempoBpm: tempo,
        musicalKey,
      });
      router.push(`/studio/song/${song.id}`);
    } catch (err) {
      console.error(err);
      setCreating(false);
    }
  };

  return (
    <div className="min-h-screen p-8 max-w-2xl mx-auto">
      <h1 className="text-2xl font-bold mb-6">Create New Song</h1>

      <div className="bg-neutral-700 border border-neutral-500 rounded-[16px] p-6 space-y-5">
        <div>
          <label className="text-sm text-neutral-400">Song Title *</label>
          <input
            value={title}
            onChange={e => setTitle(e.target.value)}
            placeholder="Midnight Echo"
            className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-3 text-sm"
          />
        </div>

        <div>
          <label className="text-sm text-neutral-400">Lyrics / Theme / Prompt</label>
          <textarea
            value={lyrics}
            onChange={e => setLyrics(e.target.value)}
            rows={6}
            placeholder="Write your lyrics or describe the vibe you want..."
            className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-3 text-sm resize-none"
          />
        </div>

        <div>
          <label className="text-sm text-neutral-400">
            Mood: {mood < 0.3 ? "Chill" : mood < 0.7 ? "Balanced" : "Hype"} ({(mood * 100).toFixed(0)}%)
          </label>
          <input
            type="range"
            min={0}
            max={1}
            step={0.01}
            value={mood}
            onChange={e => setMood(parseFloat(e.target.value))}
            className="w-full mt-1 accent-primary"
          />
          <div className="flex justify-between text-xs text-neutral-400 mt-1">
            <span>Chill</span><span>Hype</span>
          </div>
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div>
            <label className="text-sm text-neutral-400">Tempo (BPM)</label>
            <input
              type="number"
              value={tempo}
              onChange={e => setTempo(parseInt(e.target.value) || 120)}
              className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-3 text-sm"
            />
          </div>
          <div>
            <label className="text-sm text-neutral-400">Key</label>
            <select
              value={musicalKey}
              onChange={e => setMusicalKey(e.target.value)}
              className="w-full mt-1 bg-neutral-900 border border-neutral-500 rounded-md p-3 text-sm"
            >
              {["C Major","C Minor","D Major","D Minor","E Major","E Minor",
                "F Major","F Minor","G Major","G Minor","A Major","A Minor",
                "B Major","B Minor"].map(k => (
                <option key={k} value={k}>{k}</option>
              ))}
            </select>
          </div>
        </div>

        {!clientId && (
          <p className="text-accent text-xs">No client profile found. <a href="/onboarding/profile" className="underline">Complete onboarding first.</a></p>
        )}

        <button
          onClick={handleCreate}
          disabled={!title || !clientId || creating}
          className="w-full bg-primary text-white rounded-md py-3 font-medium disabled:opacity-40"
        >
          {creating ? "Creating..." : "Create Song Draft →"}
        </button>
      </div>
    </div>
  );
}
