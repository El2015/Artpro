import { Router } from 'express';
import { prisma } from '../lib/prisma';

const router = Router();

router.get('/:clientId/overview', async (req, res, next) => {
  try {
    const songs = await prisma.song.findMany({
      where: { clientId: req.params.clientId },
      include: {
        valuations: { orderBy: { calculatedAt: 'desc' }, take: 1 },
        transactions: true,
        nftContract: { include: { tiers: true } },
      },
    });

    const totalRevenue = songs.reduce((sum, s) =>
      sum + s.transactions.reduce((ts, t) => ts + Number(t.amountUsd), 0), 0
    );

    const latestValuation = songs[0]?.valuations[0]?.pointEstimate ?? 0;

    const totalMinted = songs.reduce((sum, s) =>
      sum + (s.nftContract?.tiers.reduce((ts, t) => ts + t.supplyMinted, 0) ?? 0), 0
    );

    const totalSupply = songs.reduce((sum, s) =>
      sum + (s.nftContract?.tiers.reduce((ts, t) => ts + t.supplyTotal, 0) ?? 0), 0
    );

    res.json({
      currentValue: Number(latestValuation),
      revenueMtd: totalRevenue,
      nftsSold: `${totalMinted} / ${totalSupply}`,
      reachTrend: [],
      valuationTrend: [],
    });
  } catch (err) { next(err); }
});

router.get('/:clientId/revenue', async (req, res, next) => {
  try {
    const txns = await prisma.revenueTransaction.findMany({
      where: { song: { clientId: req.params.clientId } },
      orderBy: { occurredAt: 'desc' },
    });
    res.json(txns);
  } catch (err) { next(err); }
});

