router.get('/:id/methodology', async (req, res, next) => {
  try {
    const plan = await prisma.businessPlan.findUniqueOrThrow({
      where: { id: req.params.id },
      include: { song: { include: { valuations: { orderBy: { calculatedAt: 'desc' }, take: 1 } } } },
    });
    const v = plan.song?.valuations[0];
    res.json({
      factorBreakdown: v?.factorBreakdown ?? null,
      pointEstimate: v?.pointEstimate ?? 0,
      range: { low: v?.rangeLow ?? 0, high: v?.rangeHigh ?? 0 },
      confidence: v?.confidence ?? 'LOW',
    });
  } catch (err) { next(err); }
