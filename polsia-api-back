import { Server } from 'socket.io';
import { Server as HttpServer } from 'http';

let io: Server;

export function initWebSocket(httpServer: HttpServer) {
  io = new Server(httpServer, { cors: { origin: '*' } });

  io.on('connection', (socket) => {
    socket.on('subscribe:job', (jobId: string) => socket.join(`job:${jobId}`));
    socket.on('subscribe:valuation', (songId: string) => socket.join(`valuation:${songId}`));
    socket.on('subscribe:nft', (contractId: string) => socket.join(`nft:${contractId}`));
  });

  return io;
}

export function broadcastJobUpdate(jobId: string, stage: string) {
  io?.to(`job:${jobId}`).emit('job:update', { jobId, stage, timestamp: new Date() });
}

export function broadcastValuationUpdate(songId: string, valuation: any) {
  io?.to(`valuation:${songId}`).emit('valuation:update', valuation);
}

export function broadcastNFTActivity(contractId: string, tierData: any) {
  io?.to(`nft:${contractId}`).emit('nft:tier_sold', tierData);
}
