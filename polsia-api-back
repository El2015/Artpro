import { prisma } from '../lib/prisma';
import { broadcastJobUpdate } from './websocket.service';
import { JobType, JobStage } from '@prisma/client';

interface EnqueueParams {
  songId?: string;
  videoId?: string;
  jobType: JobType;
  modelVersion?: string;
}

export async function enqueueGenerationJob(params: EnqueueParams) {
  const job = await prisma.generationJob.create({
    data: {
      songId: params.songId,
      videoId: params.videoId,
      jobType: params.jobType,
      modelVersion: params.modelVersion,
      stage: 'QUEUED',
    },
  });

  broadcastJobUpdate(job.id, 'QUEUED');
  processJob(job.id, params.jobType);
  return job;
}

async function processJob(jobId: string, jobType: JobType) {
  const AI_JOBS: JobType[] = ['AUDIO_COMPOSITION', 'VIDEO_RENDER', 'TEASER_CUT', 'VOICE_CLONE'];
  const HUMAN_JOBS: JobType[] = ['AUDIO_MIX', 'VIDEO_EDIT'];

  await updateJobStage(jobId, 'PROCESSING');

  if (AI_JOBS.includes(jobType)) {
    // Placeholder: in production, call self-hosted inference endpoint
    setTimeout(() => updateJobStage(jobId, 'COMPLETE'), 5000);
  }
  if (HUMAN_JOBS.includes(jobType)) {
    await updateJobStage(jobId, 'NEEDS_HUMAN_INPUT');
  }
}

export async function updateJobStage(jobId: string, stage: JobStage) {
  const job = await prisma.generationJob.update({
    where: { id: jobId },
    data: {
      stage,
      completedAt: stage === 'COMPLETE' ? new Date() : undefined,
    },
  });

  broadcastJobUpdate(jobId, stage);

  if (stage === 'COMPLETE' && job.songId) {
    await prisma.song.update({
      where: { id: job.songId },
      data: { status: 'HUMAN_REVIEW' },
    });
  }

  return job;
}
