import { prisma } from '../lib/prisma';

export async function calculateValuation(songId: string) {
  const song = await prisma.song.findUniqueOrThrow({
    where: { id: songId },
    include: { client: { include: { audienceSnaps: true } } },
  });

  // Stub scoring — replace with real model per valuation engine spec
  const audienceScore = scoreAudienceReach(song.client);
  const compsScore = 3000;
  const royaltyScore = 2000;
  const licensingScore = 1500;
  const scarcityScore = 1000;

  const weights = { audience: 0.30, comps: 0.25, royalty: 0.25, licensing: 0.10, scarcity: 0.10 };

  const pointEstimate =
    audienceScore * weights.audience +
    compsScore * weights.comps +
    royaltyScore * weights.royalty +
    licensingScore * weights.licensing +
    scarcityScore * weights.scarcity;

  const factorBreakdown = {
    audience_reach: { weight: weights.audience, score: audienceScore },
    comparable_sales: { weight: weights.comps, score: compsScore },
    royalty_npv: { weight: weights.royalty, score: royaltyScore },
    licensing: { weight: weights.licensing, score: licensingScore },
    scarcity: { weight: weights.scarcity, score: scarcityScore },
  };

  return prisma.valuation.create({
    data: {
      songId,
      pointEstimate,
      rangeLow: pointEstimate * 0.6,
      rangeHigh: pointEstimate * 1.8,
      confidence: 'MEDIUM',
      factorBreakdown,
    },
  });
}

function scoreAudienceReach(client: any): number {
  const snaps = client.audienceSnaps || [];
  const totalFollowers = snaps.reduce((sum: number, s: any) => sum + s.followerCount, 0);
  return Math.min(totalFollowers * 0.5, 10000);
}
EOF

