import { Router } from 'express';
import { prisma } from '../lib/prisma';
import { broadcastNFTActivity } from '../services/websocket.service';

const router = Router();

router.get('/:slug', async (req, res, next) => {
  try {
    const client = await prisma.client.findUniqueOrThrow({
      where: { slug: req.params.slug },
      include: {
        brandProfile: true,
        songs: {
          include: { video: true, nftContract: { include: { tiers: true } } },
        },
      },
    });
    res.json(client);
  } catch (err) { next(err); }
});

router.post('/:slug/mint', async (req, res, next) => {
  try {
    const { nftTierId, buyerWallet, txHash, amountUsd } = req.body;

    const tier = await prisma.nFTTier.update({
      where: { id: nftTierId },
      data: { supplyMinted: { increment: 1 } },
    });

    const contract = await prisma.nFTContract.findFirstOrThrow({
      where: { tiers: { some: { id: nftTierId } } },
    });

    await prisma.revenueTransaction.create({
      data: {
        nftTierId,
        songId: contract.songId,
        type: 'NFT_PRIMARY_SALE',
        amountUsd,
        buyerWallet,
        txHash,
      },
    });

    broadcastNFTActivity(contract.id, tier);
    res.json({ success: true, tier });
  } catch (err) { next(err); }
});

export default router;
