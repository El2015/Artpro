import { expect } from "chai";
import { ethers } from "hardhat";
import { loadFixture } from "@nomicfoundation/hardhat-toolbox/network-helpers";

describe("PolsiaSongNFT", function () {
  async function deployFixture() {
    const [platform, artist, buyer1, buyer2] = await ethers.getSigners();

    const mkTier = (supply: number, price: string, royaltyBps: number, equity: boolean) => ({
      supplyTotal: supply, supplyMinted: 0, priceWei: ethers.parseEther(price),
      royaltyShareBps: royaltyBps,
      unlockExclusiveCut: true, unlockDiscordRole: true, unlockEquityOption: equity,
    });

    const PolsiaSongNFT = await ethers.getContractFactory("PolsiaSongNFT");
    const contract = await PolsiaSongNFT.deploy(
      "Midnight Echo", "MECHO", artist.address, platform.address, 1000,
      mkTier(1000, "0.01", 0, false),
      mkTier(100, "0.1", 0, false),
      mkTier(10, "1.0", 500, true)
    );
    return { contract, platform, artist, buyer1, buyer2 };
  }

  describe("Minting", function () {
    it("mints Collector tier and assigns owner", async function () {
      const { contract, buyer1 } = await loadFixture(deployFixture);
      await contract.connect(buyer1).mint(0, { value: ethers.parseEther("0.01") });
      expect(await contract.ownerOf(0)).to.equal(buyer1.address);
    });

    it("rejects insufficient payment", async function () {
      const { contract, buyer1 } = await loadFixture(deployFixture);
      await expect(contract.connect(buyer1).mint(0, { value: ethers.parseEther("0.001") }))
        .to.be.revertedWith("Polsia: insufficient payment");
    });

    it("refunds overpayment", async function () {
      const { contract, buyer1 } = await loadFixture(deployFixture);
      const before = await ethers.provider.getBalance(buyer1.address);
      const tx = await contract.connect(buyer1).mint(0, { value: ethers.parseEther("0.02") });
      const receipt = await tx.wait();
      const gas = receipt!.gasUsed * receipt!.gasPrice;
      const after = await ethers.provider.getBalance(buyer1.address);
      expect(before - after).to.be.closeTo(ethers.parseEther("0.01") + gas, ethers.parseEther("0.0001"));
    });

    it("enforces supply cap per tier", async function () {
      const { contract, buyer2 } = await loadFixture(deployFixture);
      const signers = await ethers.getSigners();
      for (let i = 0; i < 10; i++) {
        await contract.connect(signers[i]).mint(2, { value: ethers.parseEther("1.0") });
      }
      await expect(contract.connect(buyer2).mint(2, { value: ethers.parseEther("1.0") }))
        .to.be.revertedWith("Polsia: tier sold out");
    });

    it("distributes primary sale 70/30 on price (not overpayment)", async function () {
      const { contract, artist, platform, buyer1 } = await loadFixture(deployFixture);
      const aB = await ethers.provider.getBalance(artist.address);
      const pB = await ethers.provider.getBalance(platform.address);
      await contract.connect(buyer1).mint(0, { value: ethers.parseEther("0.02") }); // overpay
      expect((await ethers.provider.getBalance(artist.address)) - aB).to.equal(ethers.parseEther("0.007"));
      expect((await ethers.provider.getBalance(platform.address)) - pB).to.equal(ethers.parseEther("0.003"));
    });
  });

  describe("EIP-2981", function () {
    it("returns 10% royalty to artist on secondary sale", async function () {
      const { contract, artist, buyer1 } = await loadFixture(deployFixture);
      await contract.connect(buyer1).mint(0, { value: ethers.parseEther("0.01") });
      const [receiver, amount] = await contract.royaltyInfo(0, ethers.parseEther("1.0"));
      expect(receiver).to.equal(artist.address);
      expect(amount).to.equal(ethers.parseEther("0.1"));
    });
  });

  describe("Perk Gating", function () {
    it("returns correct perks per tier", async function () {
      const { contract, buyer1 } = await loadFixture(deployFixture);
      await contract.connect(buyer1).mint(0, { value: ethers.parseEther("0.01") });
      const [cut, discord, equity] = await contract.unlockBusinessPerk(0);
      expect(cut).to.be.true; expect(discord).to.be.true; expect(equity).to.be.false;
    });
    it("reverts for nonexistent token", async function () {
      const { contract } = await loadFixture(deployFixture);
      await expect(contract.unlockBusinessPerk(999)).to.be.revertedWith("Polsia: token does not exist");
    });
  });

  describe("Investor Royalty Streaming", function () {
    it("pays pro-rata share to minted investor", async function () {
      const { contract, platform, buyer1 } = await loadFixture(deployFixture);
      await contract.connect(buyer1).mint(2, { value: ethers.parseEther("1.0") });
      await contract.connect(platform).depositStreamingRoyalty({ value: ethers.parseEther("10.0") });
      const before = await ethers.provider.getBalance(buyer1.address);
      const tx = await contract.connect(buyer1).claimStreamingRoyalty(0);
      const receipt = await tx.wait();
      const gas = receipt!.gasUsed * receipt!.gasPrice;
      expect((await ethers.provider.getBalance(buyer1.address)) - before + gas)
        .to.equal(ethers.parseEther("0.5"));
    });

    it("prevents double-claim", async function () {
      const { contract, platform, buyer1 } = await loadFixture(deployFixture);
      await contract.connect(buyer1).mint(2, { value: ethers.parseEther("1.0") });
      await contract.connect(platform).depositStreamingRoyalty({ value: ethers.parseEther("10.0") });
      await contract.connect(buyer1).claimStreamingRoyalty(0);
      await expect(contract.connect(buyer1).claimStreamingRoyalty(0))
        .to.be.revertedWith("Polsia: nothing to claim");
    });

    it("rejects claim from non-owner", async function () {
      const { contract, platform, buyer1, buyer2 } = await loadFixture(deployFixture);
      await contract.connect(buyer1).mint(2, { value: ethers.parseEther("1.0") });
      await contract.connect(platform).depositStreamingRoyalty({ value: ethers.parseEther("10.0") });
      await expect(contract.connect(buyer2).claimStreamingRoyalty(0))
        .to.be.revertedWith("Polsia: not token owner");
    });

    it("rejects claim on non-investor token", async function () {
      const { contract, platform, buyer1 } = await loadFixture(deployFixture);
      await contract.connect(buyer1).mint(0, { value: ethers.parseEther("0.01") });
      await contract.connect(platform).depositStreamingRoyalty({ value: ethers.parseEther("10.0") });
      await expect(contract.connect(buyer1).claimStreamingRoyalty(0))
        .to.be.revertedWith("Polsia: not an investor tier token");
    });

    it("rejects deposit before any investor mints", async function () {
      const { contract, platform } = await loadFixture(deployFixture);
      await expect(contract.connect(platform).depositStreamingRoyalty({ value: 1 }))
        .to.be.revertedWith("Polsia: no investors yet");
    });
  });

  describe("Access Control", function () {
    it("blocks non-platform royalty deposit", async function () {
      const { contract, buyer1 } = await loadFixture(deployFixture);
      await expect(contract.connect(buyer1).depositStreamingRoyalty({ value: 1 })).to.be.reverted;
    });
    it("blocks non-platform price update", async function () {
      const { contract, buyer1 } = await loadFixture(deployFixture);
      await expect(contract.connect(buyer1).updateTierPrice(0, 1)).to.be.reverted;
    });
  });
});
EOF

