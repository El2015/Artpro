// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC721/ERC721.sol";
import "@openzeppelin/contracts/token/common/ERC2981.sol";
import "@openzeppelin/contracts/access/AccessControl.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/// @title PolsiaSongNFT
/// @notice Per-song NFT: tiered minting, EIP-2981 royalties, business-perk
///         gating, and investor royalty streaming (checkpointed accrual).
contract PolsiaSongNFT is ERC721, ERC2981, AccessControl, ReentrancyGuard {
    bytes32 public constant ARTIST_ROLE = keccak256("ARTIST_ROLE");
    bytes32 public constant PLATFORM_ROLE = keccak256("PLATFORM_ROLE");

    enum Tier { COLLECTOR, SUPERFAN, INVESTOR }

    struct TierConfig {
        uint256 supplyTotal;
        uint256 supplyMinted;
        uint256 priceWei;
        uint256 royaltyShareBps;
        bool unlockExclusiveCut;
        bool unlockDiscordRole;
        bool unlockEquityOption;
    }

    uint256 private _nextTokenId;

    string public songTitle;
    address public artist;
    address public platformTreasury;

    mapping(Tier => TierConfig) public tierConfigs;
    mapping(uint256 => Tier) public tokenTier;

    // Royalty streaming: accrual-per-token pattern (scaled 1e18)
    uint256 public accRoyaltyPerToken;
    mapping(uint256 => uint256) public royaltyCheckpoint;

    event TierMinted(address indexed buyer, uint256 indexed tokenId, Tier tier, uint256 pricePaid);
    event RoyaltyDeposited(uint256 amount);
    event RoyaltyClaimed(uint256 indexed tokenId, address indexed claimant, uint256 amount);
    event BusinessPerkUnlocked(uint256 indexed tokenId, address indexed owner);

    constructor(
        string memory _songTitle,
        string memory _symbol,
        address _artist,
        address _platformTreasury,
        uint96 _royaltyBps,
        TierConfig memory collectorConfig,
        TierConfig memory superfanConfig,
        TierConfig memory investorConfig
    ) ERC721(_songTitle, _symbol) {
        songTitle = _songTitle;
        artist = _artist;
        platformTreasury = _platformTreasury;

        _grantRole(DEFAULT_ADMIN_ROLE, _platformTreasury);
        _grantRole(ARTIST_ROLE, _artist);
        _grantRole(PLATFORM_ROLE, _platformTreasury);

        _setDefaultRoyalty(_artist, _royaltyBps);

        tierConfigs[Tier.COLLECTOR] = collectorConfig;
        tierConfigs[Tier.SUPERFAN] = superfanConfig;
        tierConfigs[Tier.INVESTOR] = investorConfig;
    }

    // ─────────────────── MINTING ───────────────────

    function mint(Tier tier) external payable nonReentrant returns (uint256) {
        TierConfig storage config = tierConfigs[tier];

        require(config.supplyMinted < config.supplyTotal, "Polsia: tier sold out");
        require(msg.value >= config.priceWei, "Polsia: insufficient payment");

        config.supplyMinted += 1;
        uint256 tokenId = _nextTokenId;
        _nextTokenId++;

        tokenTier[tokenId] = tier;
        _safeMint(msg.sender, tokenId);

        if (tier == Tier.INVESTOR) {
            royaltyCheckpoint[tokenId] = accRoyaltyPerToken;
        }

        // Split on PRICE, not msg.value (excess refunded below)
        _distributePrimarySale(config.priceWei);

        emit TierMinted(msg.sender, tokenId, tier, config.priceWei);
        emit BusinessPerkUnlocked(tokenId, msg.sender);

        if (msg.value > config.priceWei) {
            (bool refunded, ) = msg.sender.call{value: msg.value - config.priceWei}("");
            require(refunded, "Polsia: refund failed");
        }

        return tokenId;
    }

    function _distributePrimarySale(uint256 amount) internal {
        // 70% artist / 30% platform treasury (platform's 30% covers the
        // 20% platform fee + 10% marketing reinvestment, allocated off-chain)
        uint256 artistShare = (amount * 7000) / 10000;
        uint256 platformShare = amount - artistShare;

        (bool a, ) = artist.call{value: artistShare}("");
        require(a, "Polsia: artist payout failed");

        (bool p, ) = platformTreasury.call{value: platformShare}("");
        require(p, "Polsia: platform payout failed");
    }

    // ─────────── BUSINESS PERK GATING ───────────

    function unlockBusinessPerk(uint256 tokenId)
        external view
        returns (bool exclusiveCut, bool discordRole, bool equityOption)
    {
        require(_ownerOf(tokenId) != address(0), "Polsia: token does not exist");
        TierConfig memory config = tierConfigs[tokenTier[tokenId]];
        return (config.unlockExclusiveCut, config.unlockDiscordRole, config.unlockEquityOption);
    }

    // ─────────── INVESTOR ROYALTY STREAMING ───────────

    /// @notice Distributes deposits across investor tokens minted AT DEPOSIT
    ///         TIME. Each token accrues only from deposits after its mint.
    function depositStreamingRoyalty() external payable onlyRole(PLATFORM_ROLE) {
        uint256 minted = tierConfigs[Tier.INVESTOR].supplyMinted;
        require(minted > 0, "Polsia: no investors yet");
        accRoyaltyPerToken +=
            (msg.value * tierConfigs[Tier.INVESTOR].royaltyShareBps * 1e18) / 10000 / minted;
        emit RoyaltyDeposited(msg.value);
    }

    function claimStreamingRoyalty(uint256 tokenId) external nonReentrant {
        require(ownerOf(tokenId) == msg.sender, "Polsia: not token owner");
        require(tokenTier[tokenId] == Tier.INVESTOR, "Polsia: not an investor tier token");

        uint256 pending = (accRoyaltyPerToken - royaltyCheckpoint[tokenId]) / 1e18;
        require(pending > 0, "Polsia: nothing to claim");

        royaltyCheckpoint[tokenId] = accRoyaltyPerToken;

        (bool success, ) = msg.sender.call{value: pending}("");
        require(success, "Polsia: claim transfer failed");

        emit RoyaltyClaimed(tokenId, msg.sender, pending);
    }

    // ─────────── ADMIN ───────────

    function updateTierPrice(Tier tier, uint256 newPriceWei) external onlyRole(PLATFORM_ROLE) {
        tierConfigs[tier].priceWei = newPriceWei;
    }

    function getTierAvailability(Tier tier) external view returns (uint256) {
        TierConfig memory config = tierConfigs[tier];
        return config.supplyTotal - config.supplyMinted;
    }

    function supportsInterface(bytes4 interfaceId)
        public view override(ERC721, ERC2981, AccessControl) returns (bool)
    {
        return super.supportsInterface(interfaceId);
    }
}
EOF

cat > contracts/PolsiaSongNFTFactory.sol << 'EOF'
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "./PolsiaSongNFT.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract PolsiaSongNFTFactory is Ownable {
    address public platformTreasury;

    struct DeployedSong {
        address contractAddress;
        address artist;
        string songTitle;
        uint256 deployedAt;
    }

    DeployedSong[] public deployedSongs;
    mapping(address => address[]) public artistToContracts;

    event SongContractDeployed(address indexed contractAddress, address indexed artist, string songTitle);

    constructor(address _platformTreasury) Ownable(msg.sender) {
        platformTreasury = _platformTreasury;
    }

    function deploySongContract(
        string memory songTitle,
        string memory symbol,
        address artistAddr,
        uint96 royaltyBps,
        PolsiaSongNFT.TierConfig memory collectorConfig,
        PolsiaSongNFT.TierConfig memory superfanConfig,
        PolsiaSongNFT.TierConfig memory investorConfig
    ) external onlyOwner returns (address) {
        PolsiaSongNFT newContract = new PolsiaSongNFT(
            songTitle, symbol, artistAddr, platformTreasury, royaltyBps,
            collectorConfig, superfanConfig, investorConfig
        );
        address contractAddr = address(newContract);

        deployedSongs.push(DeployedSong(contractAddr, artistAddr, songTitle, block.timestamp));
        artistToContracts[artistAddr].push(contractAddr);

        emit SongContractDeployed(contractAddr, artistAddr, songTitle);
        return contractAddr;
    }

    function getDeployedSongsCount() external view returns (uint256) { return deployedSongs.length; }
    function getArtistContracts(address artistAddr) external view returns (address[] memory) {
        return artistToContracts[artistAddr];
    }
    function updatePlatformTreasury(address newTreasury) external onlyOwner {
        platformTreasury = newTreasury;
    }
}
EOF

