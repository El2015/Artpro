"use client";
import { useEffect, useState } from "react";
import { getSocket } from "@/lib/socket";
import type { JobStage } from "@/types";

export function useJobStatus(jobId: string | undefined, initial: JobStage = "QUEUED") {
  const [stage, setStage] = useState<JobStage>(initial);
  useEffect(() => {
    if (!jobId) return;
    const s = getSocket();
    s.emit("subscribe:job", jobId);
    const handler = (p: { jobId: string; stage: JobStage }) => { if (p.jobId === jobId) setStage(p.stage); };
    s.on("job:update", handler);
    return () => { s.off("job:update", handler); };
  }, [jobId]);
  return { stage };
}
EOF

