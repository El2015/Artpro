"use client";
import { useEffect, useState } from "react";
import { getSocket } from "@/lib/socket";
import type { NFTTier } from "@/types";

export function useNftActivity(contractId: string, initial: NFTTier[]) {
  const [tiers, setTiers] = useState<NFTTier[]>(initial);
  useEffect(() => {
    const s = getSocket();
    s.emit("subscribe:nft", contractId);
    const handler = (t: NFTTier) => setTiers(prev => prev.map(p => p.id === t.id ? t : p));
    s.on("nft:tier_sold", handler);
    return () => { s.off("nft:tier_sold", handler); };
  }, [contractId]);
  return tiers;
}
EOF

